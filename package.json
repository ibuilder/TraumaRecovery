{
  "name": "healing-together",
  "version": "1.0.0",
  "private": true,
  "description": "Healing Together — A Practical Guide to Trauma Recovery for Ordinary People",
  "author": "Matthew M. Emma",
  "license": "MIT",
  "type": "module",
  "homepage": "https://ibuilder.github.io/TraumaRecovery/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibuilder/TraumaRecovery.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build:pages": "tsx script/build-pages.ts",
    "preview": "vite preview --outDir ../dist/public",
    "check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifest": "tsx script/generate-manifest.ts",
    "search-index": "tsx script/generate-search-index.ts",
    "book-fonts": "tsx script/generate-book-fonts.ts",
    "check:print": "tsx script/check-print-ready.ts",
    "epub": "tsx script/build-epub.ts",
    "check:epub": "tsx script/check-epub.ts",
    "validate:content": "tsx script/validate-content.ts",
    "serve:static": "tsx script/serve-static.ts",
    "screenshots": "tsx script/capture-screenshots.ts",
    "test": "playwright test",
    "test:site": "playwright test tests/site.spec.ts",
    "test:book": "playwright test tests/book.spec.ts",
    "check:pages": "tsx script/check-pages-build.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.12.0",
    "marked": "^18.0.11",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.20.4"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
